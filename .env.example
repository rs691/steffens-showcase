# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test keys for development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Session signing (32+ chars; generate with: openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-secret

# Vercel AI Gateway (Design Copilot)
# Prefer AI_GATEWAY_API_KEY; OIDC from `vercel env pull` also works on Vercel.
AI_GATEWAY_API_KEY=your-ai-gateway-key
# Optional model override (provider/model format)
AI_MODEL=openai/gpt-5-mini
# Optional embedding model for RAG (Phase 2)
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
